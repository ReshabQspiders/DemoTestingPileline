pipeline {

    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out Selenium framework from GitHub'
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                echo 'Executing Selenium tests using Maven and TestNG'
                bat 'mvn -B clean test'
            }
        }
    }

    post {

        always {
            echo 'Publishing TestNG execution reports'

            junit(
                testResults: 'target/surefire-reports/TEST-*.xml'
            )
        }

        success {
            echo 'Selenium automation tests completed successfully'
        }

        failure {
            echo 'Selenium automation pipeline failed'
        }
    }
